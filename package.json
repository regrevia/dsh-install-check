{
  "name": "dsh-install-check",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Looks at a plugin before it lands: name collisions and missing plugin dependencies, stated as one short sentence and one suggestion.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "install-check"
  ],
  "license": "MIT",
  "author": "regrevia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-install-check.git"
  },
  "homepage": "https://github.com/regrevia/dsh-install-check#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  }
}
